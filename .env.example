# =============================================================================
# Bot Service Lite (meetings-only) — environment. Copy to .env:  cp .env.example .env
# `make lite` copies this automatically on first run if .env is absent.
# =============================================================================
# NOTE: keep comments on their OWN line, never trailing a value. This file is consumed by
# `docker run --env-file` (deploy/lite), whose parser does NOT strip an inline comment — it
# becomes part of the value.

# --- image ---------------------------------------------------------------------
IMAGE_TAG=v012

# --- stack secrets (CHANGE for any non-local deploy) ----------------------------
# admin-api auth; `make lite` mints your API key with this (see: docker logs bot-service-lite)
ADMIN_TOKEN=changeme

# --- transcription (STT) ---------------------------------------------------------
# Self-host the bundled service (deploy/transcription — GPU or CPU, deployed separately from this
# stack) and point URL at its load balancer (base URL; the client appends
# /v1/audio/transcriptions), e.g. http://<gpu-host>:8083. TOKEN must match that unit's API_TOKEN.
# Or use a hosted token from https://vexa.ai/account. Or run `make -C deploy/lite up LOCAL_STT=1`
# for a bundled zero-config CPU whisper (no token needed). Without any of these, bots join +
# record but produce no transcript.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=

# Deployment-level defaults for a spawn's flags when the request does not say (config.v1
# `defaulted`). Both default true — and LEFT EMPTY BELOW STILL MEANS true: only an explicit
# false/0/no/off opts out.
TRANSCRIBE_ENABLED=
RECORDING_ENABLED=

# Optional Google Meet speaker-stream tuning. Empty preserves the bot's defaults.
BOT_SPEAKER_MIN_AUDIO_SEC=
BOT_SPEAKER_SUBMIT_INTERVAL_SEC=
BOT_SPEAKER_CONFIRM_THRESHOLD=
BOT_SPEAKER_MAX_BUFFER_SEC=
BOT_SPEAKER_IDLE_TIMEOUT_SEC=

# Self-hosted Jitsi hostnames (comma-separated, e.g. calls.example.org) recognized when parsing
# pasted meeting links AND calendar (ICS) links. meet.jit.si and hosts naming "jitsi" are always
# recognized; hosts with a "meet" label are recognized in pasted links.
VEXA_JITSI_HOSTS=

# --- recordings storage backend --------------------------------------------------
# "minio" (default — the sidecar `make lite` provisions) or "azure_blob" (the two vars below).
# Switching requires `make -C deploy/lite up` to recreate the app container.
STORAGE_BACKEND=minio
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=vexa

# --- gateway edge guard (fastapi-guard) -----------------------------------------
# Per-IP rate limiting + auto-IP-ban at the gateway edge. ON BY DEFAULT with generous limits
# (600 requests/min per IP) — to opt OUT, uncomment GUARD_ENABLED=false.
#GUARD_ENABLED=false
#GUARD_WS_ENABLED=false
#GUARD_RATE_LIMIT_RPM=600
#GUARD_AUTO_BAN_THRESHOLD=10
#GUARD_AUTO_BAN_DURATION=3600
#GUARD_IP_BLACKLIST=
#GUARD_IP_WHITELIST=
#GUARD_TRUSTED_PROXIES=
