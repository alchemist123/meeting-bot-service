# BuildKit uses THIS file (next to the Dockerfile) instead of the root .dockerignore for
# `docker build -f deploy/lite/Dockerfile.lite .`. The root one is tuned for the meeting-api
# build and excludes **/dist/ — but the lite image builds the bot workspace (core/) from source
# and needs its dist/ output, so we KEEP that while still dropping the heavy/irrelevant trees
# (node_modules, venvs, caches).
**/node_modules
**/.next
**/.venv
**/__pycache__
**/.pytest_cache
**/.turbo
.git
*.log
.DS_Store
.recordings
**/.recordings
.env
.env.*
deploy/execution-targets.json
