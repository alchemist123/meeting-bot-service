# =============================================================================
# Bot Service Lite (compose) — environment. Copy to .env:  cp .env.example .env
# `make dev` copies this automatically on first run if .env is absent.
# =============================================================================
# NOTE: keep comments on their OWN line, never trailing a value.

# --- project + host ports ------------------------------------------------------
COMPOSE_PROJECT_NAME=bot-service-lite
API_GATEWAY_HOST_PORT=18056
ADMIN_API_PORT=18057
MEETING_API_PORT=18080
RUNTIME_API_PORT=18090
POSTGRES_HOST_PORT=5458
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# --- images ----------------------------------------------------------------------
IMAGE_TAG=dev
# Built locally with `make -C deploy/compose bot` (default tag: bot-service-lite/bot-service-bot:dev).
# Point this at your build so the runtime spawns it.
BROWSER_IMAGE=bot-service-lite/bot-service-bot:dev
DOCKER_GID=0
LOG_LEVEL=info

# --- database --------------------------------------------------------------------
DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=postgres

# --- object store (MinIO) ---------------------------------------------------------
MINIO_ROOT_USER=vexa-access-key
MINIO_ROOT_PASSWORD=vexa-secret-key
MINIO_ACCESS_KEY=vexa-access-key
MINIO_SECRET_KEY=vexa-secret-key
MINIO_BUCKET=vexa
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

# --- recordings storage backend ----------------------------------------------------
# "minio" (default, the MinIO settings above) or "azure_blob" (the two vars below).
# Switching requires restarting meeting-api.
STORAGE_BACKEND=minio
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=vexa

# --- stack secrets (CHANGE for any non-local deploy) -------------------------------
ADMIN_TOKEN=dev-admin-token
INTERNAL_API_SECRET=vexa-internal-secret
# Optional: single shared secret for simple/self-host use. Send it as `X-API-Key` on every
# request and it authenticates with full scopes — no per-user token minting
# (bin/provision-token) needed. Blank (default) disables this path entirely.
SHARED_API_TOKEN=

# --- transcription (STT) -----------------------------------------------------------
# Self-host deploy/transcription (GPU or CPU, deployed separately) or use a hosted token
# from https://vexa.ai/account. Without it, bots join + record but produce no transcript.
TRANSCRIPTION_SERVICE_URL=
TRANSCRIPTION_SERVICE_TOKEN=

# Deployment-level defaults for a spawn's flags when the request does not say. Both default
# true — an explicit false/0/no/off opts out.
TRANSCRIBE_ENABLED=
RECORDING_ENABLED=
BOT_SPEAKER_MIN_AUDIO_SEC=
BOT_SPEAKER_SUBMIT_INTERVAL_SEC=
BOT_SPEAKER_CONFIRM_THRESHOLD=
BOT_SPEAKER_MAX_BUFFER_SEC=
BOT_SPEAKER_IDLE_TIMEOUT_SEC=

# Self-hosted Jitsi hostnames (comma-separated) recognized in pasted + calendar links.
VEXA_JITSI_HOSTS=

# --- gateway edge guard (fastapi-guard) ---------------------------------------------
#GUARD_ENABLED=false
#GUARD_WS_ENABLED=false
#GUARD_ENABLE_REDIS=true
#GUARD_RATE_LIMIT_RPM=600
#GUARD_RATE_LIMIT_WINDOW=60
#GUARD_AUTO_BAN_THRESHOLD=10
#GUARD_AUTO_BAN_DURATION=3600
#GUARD_IP_BLACKLIST=
#GUARD_IP_WHITELIST=
#GUARD_TRUSTED_PROXIES=
